# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for ChatGPT API calls.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GROQ_API_KEY: Required for the Speak page STT and Groq LLM pipeline.
GROQ_API_KEY="MY_GROQ_API_KEY"

# CHINESE_TTS_PROVIDER: edge (default), azure, or google-translate.
# Edge is best for local/MVP Chinese voices without a paid realtime provider.
CHINESE_TTS_PROVIDER="edge"

# Optional: only required when CHINESE_TTS_PROVIDER="azure".
AZURE_SPEECH_KEY="MY_AZURE_SPEECH_KEY"
AZURE_SPEECH_REGION="eastasia"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NETLIFY_DATABASE_URL: Required for saving notebook/vocabulary snapshots to Netlify Database.
NETLIFY_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
